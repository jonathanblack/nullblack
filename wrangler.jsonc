{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker already attached to nullblack.com and
  // nullblackgames.com. This file does not declare routes, so a deploy
  // does not add or remove custom domains.
  "name": "nullblack",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
