{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nullblack",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-18",
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
